:root {
    --bg-color: #1e1e1e;
    --sidebar-color: #252526;
    --header-color: #2d2d30;
    --accent-color: #007acc;
    --text-color: #cccccc;
    --text-header: #ffffff;
    --border-color: #3e3e42;
    --hover-color: #37373d;
    --spacing-md: 10px;
}

.dashboard-root {
    flex-grow: 1;
    background-color: var(--bg-color);
    color: var(--text-color);
    flex-direction: row;
    font-size: 14px;
}

.sidebar {
    width: 200px;
    background-color: var(--sidebar-color);
    border-right-width: 1px;
    border-right-color: var(--border-color);
    padding: var(--spacing-md);
}

.sidebar-header {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    color: var(--text-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
    padding-bottom: 5px;
}

.tab-button {
    padding: 8px 12px;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: transparent;
    border-width: 0;
    color: var(--text-color);
    -unity-text-align: middle-left;
    transition-duration: 0.1s;
}

.tab-button:hover {
    background-color: var(--hover-color);
}

.tab-button--active {
    background-color: var(--accent-color);
    color: white;
}

.content-area {
    flex-grow: 1;
    padding: 20px;
}

.content-header {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    color: var(--text-header);
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.stat-card {
    width: 180px;
    background-color: var(--header-color);
    padding: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border-color);
}

.stat-label {
    font-size: 12px;
    color: #888888;
    margin-bottom: 5px;
}

.stat-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text-header);
}

.list-view-container {
    flex-grow: 1;
    background-color: var(--sidebar-color);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 4px;
}

.hidden {
    display: none;
}

.row-item {
    flex-direction: row;
    padding: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
}

.column-header {
    -unity-font-style: bold;
    background-color: var(--header-color);
}

.cell {
    flex-grow: 1;
    flex-basis: 0;
}
